#!/bin/sh
# commit-msg — enforce Conventional Commits on the subject line.
#
# Why this exists: it keeps the history consistent with the rest of the MIDDAG OSS
# stack (framework / ui), where release-please derives versions and CHANGELOGs from
# the commit history. The demo follows the same convention for a clean log.
#
# Rules enforced (subject / first line only — the body and footers are free):
#   * one of the known types,
#   * an OPTIONAL single, lowercase scope in parentheses (one scope per commit —
#     no comma-separated multi-scope, by project convention),
#   * an OPTIONAL "!" breaking-change marker before the colon,
#   * ": " then a description of at least 3 chars.
#
# Breaking changes: "!" before the colon or a "BREAKING CHANGE:" footer only
# in a family MAJOR window (version family, ADR-032 of docs-middag-ops); the
# PR check php-version-family-check refuses both otherwise. On 0.x a break
# ships as feat: with the break and the migration described in the body; never
# fix:, refactor: or chore:. See CONTRIBUTING.md "Versioning". release-please
# derives versions from these messages; NEVER create tags manually.

MSG=$(head -1 "$1")

# type(scope)!: desc | type!: desc | type(scope): desc | type: desc
PATTERN="^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert)(\([a-z0-9_-]+\))?!?: .{3,}"

if ! echo "$MSG" | grep -qE "$PATTERN"; then
    echo "[commit-msg] BLOCKED: Message must follow Conventional Commits."
    echo ""
    echo "  Format: type(scope): description     (scope optional, single + lowercase)"
    echo "  Types:  feat, fix, chore, docs, style, refactor, perf, test, build, ci, revert"
    echo "  Breaking: '!' or a 'BREAKING CHANGE:' footer only in a family MAJOR window;"
    echo "            on 0.x a break is a feat: described in the body."
    echo ""
    echo "  Examples:"
    echo "    feat(http): add a typed-DTO endpoint"
    echo "    fix: seed the SLA policy before the ticket"
    echo "    chore: bump middag-io/framework"
    echo ""
    echo "  Got: $MSG"
    exit 1
fi
